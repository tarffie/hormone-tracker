{
  "name": "hormone-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "App to keep track of your hormones and important cycles",
  "scripts": {
    "build": "pnpm --filter '*' build",
    "build-deps": "pnpm --filter './packages/*' build",
    "build:calendar": "pnpm --filter=@hormone-tracker/calendar build",
    "dev": "pnpm --filter '*' --parallel dev",
    "dev:calendar": "pnpm --filter=@hormone-tracker/calendar dev",
    "test": "pnpm --filter '*' --parallel test",
    "test:calendar": "pnpm --filter=@hormone-tracker/calendar test",
    "lint": "pnpm --filter '*' --parallel lint",
    "lint:calendar": "pnpm --filter=@hormone-tracker/calendar lint",
    "start": "pnpm --filter '*' --parallel start",
    "start:calendar": "pnpm --filter=@hormone-tracker/calendar start",
    "clean": "pnpm --filter '*' clean && rm -rf node_modules pnpm-lock.yaml",
    "clean:calendar": "pnpm --filter=@hormone-tracker/calendar clean",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "keywords": [
    "hrt",
    "trans-affirmative",
    "gender-affirmative",
    "health"
  ],
  "author": "Emilia Alves <emiliaalves.tarffie@gmail.com>",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "22.19.0",
    "pnpm": "10.12.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^16.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
