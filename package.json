{
  "name": "HormoneTracker",
  "version": "1.0.0",
  "private": true,
  "description": "App to keep track of your hormones and important cycles",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "start": "turbo run start",
    "clean": "turbo run clean && rm -rf node_modules pnpm-lock.yaml",
    "prepare": "husky"
  },
  "keywords": [
    "hrt",
    "trans-affirmative",
    "gender-affirmative",
    "health"
  ],
  "author": "Emilia Alves <emiliaalves.tarffie@gmail.com>",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "22.19.0",
    "pnpm": "10.12.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.2.1",
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
