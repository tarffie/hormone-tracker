{
  "name": "@hormone-tracker/lib",
  "version": "1.0.0",
  "private": true,
  "description": "Shared utilities for HormoneTracker, including date and HRT tracking helpers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write .",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "utilities",
    "hrt",
    "trans-affirmative",
    "health",
    "date"
  ],
  "author": "Emilia Alves <emiliaalves.tarffie@gmail.com>",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "date-fns": "4.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
